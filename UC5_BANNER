public class UC5_Banner {

    public static void main(String[] args) {

        // UC5: Array declaration + initialization using String.join()
        String[] banner = {
                String.join("", "*", "*", "*", "*", "*", "*", "*", "*", "*", "*"),
                String.join("", "*", " ", " ", " ", "WELCOME", " ", " ", " ", "*"),
                String.join("", "*", " ", " ", "TO", " ", "UC5", " ", " ", "*"),
                String.join("", "*", " ", "DECORATIVE", " ", "TEXT", " ", "*"),
                String.join("", "*", " ", "USING", " ", "STRING.JOIN()", " ", "*"),
                String.join("", "*", " ", "JAVA", " ", "BANNER", " ", "*"),
                String.join("", "*", "*", "*", "*", "*", "*", "*", "*", "*", "*")
        };

        // Enhanced for loop to print banner
        for (String line : banner) {
            System.out.println(line);
        }
    }
}